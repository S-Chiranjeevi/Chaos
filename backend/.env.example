# APIVerve API Key for Live Menstrual Cycle Calculator API
# Obtain from https://dashboard.apiverve.com
APIVERVE_API_KEY=

# Optional Google Gemini API key for AI-assisted insights
# If left empty, the backend operates entirely in offline local rule fallback mode
GEMINI_API_KEY=

# Allowed frontend origins for CORS (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Application environment (development, staging, production)
ENVIRONMENT=development

# Server host and port
HOST=0.0.0.0
PORT=8000

# MongoDB Configuration
# Local instance default: mongodb://localhost:27017
# MongoDB Atlas format: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=sakhicare_db
MONGODB_TIMEOUT_MS=3000
MONGODB_AUTO_CONNECT=true
